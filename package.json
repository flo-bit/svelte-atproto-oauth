{
	"name": "@svelte-atproto/oauth",
	"version": "0.4.0",
	"type": "module",
	"license": "MIT",
	"description": "atproto OAuth for SvelteKit with progressive permissions, server/browser clients, and pluggable session storage.",
	"keywords": [
		"atproto",
		"bluesky",
		"oauth",
		"sveltekit"
	],
	"author": "flo-bit",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/flo-bit/svelte-atproto-oauth.git"
	},
	"homepage": "https://github.com/flo-bit/svelte-atproto-oauth#readme",
	"bugs": "https://github.com/flo-bit/svelte-atproto-oauth/issues",
	"files": [
		"dist"
	],
	"bin": {
		"atproto-oauth": "./dist/bin/cli.mjs"
	},
	"exports": {
		"./server": {
			"types": "./dist/server/index.d.mts",
			"default": "./dist/server/index.mjs"
		},
		"./server/stores/memory": {
			"types": "./dist/server/stores/memory.d.mts",
			"default": "./dist/server/stores/memory.mjs"
		},
		"./server/stores/cloudflare": {
			"types": "./dist/server/stores/cloudflare.d.mts",
			"default": "./dist/server/stores/cloudflare.mjs"
		},
		"./server/stores/upstash": {
			"types": "./dist/server/stores/upstash.d.mts",
			"default": "./dist/server/stores/upstash.mjs"
		},
		"./client": {
			"types": "./dist/client/index.d.mts",
			"default": "./dist/client/index.mjs"
		},
		"./browser": {
			"types": "./dist/browser/index.d.mts",
			"default": "./dist/browser/index.mjs"
		},
		"./permissions": {
			"types": "./dist/permissions/index.d.mts",
			"default": "./dist/permissions/index.mjs"
		},
		"./network": {
			"types": "./dist/network/index.d.mts",
			"default": "./dist/network/index.mjs"
		},
		"./helper": {
			"types": "./dist/helper/index.d.mts",
			"default": "./dist/helper/index.mjs"
		},
		"./bsky": {
			"types": "./dist/bsky/index.d.mts",
			"default": "./dist/bsky/index.mjs"
		}
	},
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch",
		"check": "tsc --noEmit",
		"test": "pnpm check && pnpm build && node --test tests/*.mjs",
		"test:permissions": "pnpm check && pnpm build && node --test tests/permissions.mjs tests/permission-failure.mjs tests/server-auth.mjs tests/browser-auth.mjs tests/browser-lifecycle.mjs tests/browser-sdk-contract.mjs tests/client-auth.mjs",
		"dev:permissions": "pnpm build && pnpm --dir examples/progressive-permissions install --force && pnpm --dir examples/progressive-permissions dev",
		"changeset": "changeset",
		"version-packages": "changeset version",
		"release": "pnpm build && changeset publish",
		"prepublishOnly": "pnpm build"
	},
	"dependencies": {
		"@atcute/atproto": "^4.0.4",
		"@atcute/bluesky": "^4.0.23",
		"@atcute/client": "^5.1.2",
		"@atcute/identity-resolver": "^2.0.2",
		"@atcute/lexicons": "^2.1.1",
		"@atcute/oauth-browser-client": "^5.1.0",
		"@atcute/oauth-node-client": "^2.0.1",
		"@atcute/tid": "^1.1.4"
	},
	"peerDependencies": {
		"@sveltejs/kit": "^2.0.0 || ^3.0.0",
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@changesets/cli": "^2.31.1",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^24.19.2",
		"svelte": "^5.57.2",
		"tsdown": "^0.23.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.4"
	},
	"publishConfig": {
		"access": "public"
	}
}