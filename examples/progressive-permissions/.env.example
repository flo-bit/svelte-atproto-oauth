# Dev is loopback OAuth: no password, public metadata URL, or signing key needed.
PUBLIC_DEV_PORT=5173
# PUBLIC_ORIGIN=https://your-diagnostic.example

# Optional FULL scope tokens referring to real, published permission sets / RPCs.
# Rebuild/reinstall the example after changing the library itself.
# PUBLIC_PERMISSION_SET=include:your.namespace.authFull
# PUBLIC_RPC_SCOPE=rpc:your.namespace.someMethod?aud=did:web:api.example.com%23service

# Only for a deployed confidential server client (do not commit real values):
# ORIGIN=https://your-diagnostic.example
# COOKIE_SECRET=
# CLIENT_ASSERTION_KEY=
